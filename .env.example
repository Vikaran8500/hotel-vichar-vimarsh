# ==============================================================================
# HOTEL VICHAR VIMARSH — RECEPTION ENQUIRY SYSTEM CONFIGURATION
# ==============================================================================
# Simple Email & WhatsApp Integration (No database required)
# Copy this file to '.env' for local testing:
# cp .env.example .env
#
# IMPORTANT SECURITY NOTE:
# Never commit real API keys or '.env' files to Git.
# ==============================================================================

# Server-Side Email Configuration (Resend)
# Used by the local Vite dev server and production serverless functions (api/send-enquiry.ts)
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Reception Email Recipient
HOTEL_RECEPTION_EMAIL=HOTELVICHARVIMARSH@GMAIL.COM

# Verified Sender Email Address
# - For testing before domain verification: onboarding@resend.dev
# - For production after domain verification: reservations@yourdomain.com
VERIFIED_SENDER_EMAIL=onboarding@resend.dev

# Optional: Override the enquiry API endpoint (defaults to /api/send-enquiry)
# VITE_ENQUIRY_API_URL=https://your-custom-api.com/api/send-enquiry
